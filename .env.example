# Local development does not read Supabase credentials from this file.
# `npm run dev` gets its URL and publishable/anon key from the running local
# Supabase stack and fails closed when that stack is unavailable.
# Discord OAuth is the only local Supabase configuration read from `.env.local`.
SUPABASE_AUTH_DISCORD_CLIENT_ID=
SUPABASE_AUTH_DISCORD_SECRET=

# These values are for explicitly configured remote staging/production runtimes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Remote database/runtime variables. They are not used to configure the local
# Supabase CLI lifecycle commands.
POSTGRES_DATABASE=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_PRISMA_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=

# Local Supabase database deployment wrapper. GitHub Environments instead use
# generic SUPABASE_PROJECT_ID and SUPABASE_DB_PASSWORD environment secrets.
SUPABASE_ACCESS_TOKEN=

# Staging target for local dry-run or explicitly confirmed emergency push.
SUPABASE_STAGING_PROJECT_ID=
SUPABASE_STAGING_DB_PASSWORD=

# Production target for local dry-run or explicitly confirmed emergency push.
SUPABASE_PRODUCTION_PROJECT_ID=
SUPABASE_PRODUCTION_DB_PASSWORD=
